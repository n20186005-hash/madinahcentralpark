---
import type { Guide } from '../lib/parkGuide';
import { CATEGORIES, localizeGuide, guidePathFor } from '../data/guides';

interface Props {
  guide: Guide;
  lang?: 'ar' | 'en';
}

const { guide, lang = 'ar' } = Astro.props;
const localized = localizeGuide(guide, lang);
const category = CATEGORIES.find((item) => item.id === guide.category);
const href = guidePathFor(guide.slug, lang);
const categoryLabel = category ? (lang === 'en' ? category.labelEn : category.label) : undefined;
const cta = lang === 'en' ? 'Read the guide' : 'اقرأ الدليل';
---
<article class="flex h-full flex-col rounded-[2rem] border border-palm-900/10 bg-white p-6 transition hover:border-gold-400/60">
  {categoryLabel && <p class="text-[11px] font-black text-gold-600">{categoryLabel}</p>}
  <h3 class="mt-3 text-lg font-black leading-8 text-palm-900">
    <a class="no-underline hover:text-gold-600" href={href}>{localized.h1}</a>
  </h3>
  <p class="mt-3 flex-1 text-sm leading-8 text-palm-900/68">{localized.subtitle}</p>
  <a class="mt-5 inline-flex items-center gap-2 text-sm font-black text-palm-900 no-underline hover:text-gold-600" href={href}>
    {cta}
    <span aria-hidden="true">{lang === 'en' ? '›' : '‹'}</span>
  </a>
</article>
