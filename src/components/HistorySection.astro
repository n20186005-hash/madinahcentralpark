---
// خلفية المكان وتطوره — بمعلومات موثقة فقط، مع فصل ما هو تاريخي عن المنشأة العصرية.
interface Props {
  lang?: 'ar' | 'en';
}
const { lang = 'ar' } = Astro.props;
const isEn = lang === 'en';

const factsAr = [
  { num: '5 كم', label: 'جنوب المسجد النبوي' },
  { num: '8', label: 'مواقف رئيسية للسيارات' },
  { num: '20,000 م²', label: 'مساحة المواقف الرئيسية' },
  { num: '10,000 م²', label: 'مسارات المشاة المذكورة' },
  { num: 'بحيرة', label: 'مائية اصطناعية داخل النطاق' },
  { num: '2024', label: 'تاريخ وصف الأمانة للمرافق' }
];

const factsEn = [
  { num: '5 km', label: 'South of the Prophet’s Mosque' },
  { num: '8', label: 'Main car parks' },
  { num: '20,000 m²', label: 'Area of the main car parks' },
  { num: '10,000 m²', label: 'Mentioned pedestrian paths' },
  { num: 'Lake', label: 'Artificial water feature within the boundary' },
  { num: '2024', label: 'Date of the municipality’s facilities description' }
];

const timelineAr = [
  {
    tag: 'خلفية المكان',
    title: 'موقع الحديقة الحديثة',
    body: 'تقع الحديقة في حي الحديقة جنوب المسجد النبوي وفق وصف الأمانة ومنصة المدينة. الحديقة منشأة حضرية حديثة؛ لا ننسب إليها تاريخ معلم أثري أو مزرعة مجاورة.'
  },
  {
    tag: 'وجهة اجتماعية',
    title: 'من متنزه محلي إلى وجهة ثقافية',
    body: 'تذكر أمانة منطقة المدينة المنورة الحديقة ضمن الوجهات الاجتماعية والثقافية البارزة، إذ تجمع المسطحات الخضراء مع مبانٍ تراثية الطابع، وبحيرة اصطناعية، ومناطق ألعاب، ومرافق رياضية وثقافية، إضافة إلى قربها من سوق العينية والحي التراثي ومركز المدينة للفنون الواردة في منصة «المدينة».'
  },
  {
    tag: 'أعمال تطوير منفذة',
    title: 'تأهيل المواقف والمسارات والمسطحات',
    body: 'نشرت الأمانة أعمال تأهيل شملت رفع عدد المواقف الرئيسية إلى ثمانية بمساحة تقارب 20,000 م² مع مواقف جانبية، ومسارات مشاة بمساحة نحو 10,000 م²، وأعمال تشجير وتحسين للمشهد، إضافة إلى لافتات إرشادية مضيئة وشاشات عرض لخدمة الزوار.'
  },
  {
    tag: 'مرحلة أوسع أعلنتها الأمانة',
    title: 'تطوير الحديقة ضمن الحدائق المركزية',
    body: 'تذكر الأمانة، في سياق حزم مشاريع بلدية دشنت في 2023، مشروع تطوير واستكمال حديقة الملك فهد المركزية جنوب المدينة على مساحة 1.6 مليون متر مربع. هذا وصف لنطاق مشروع، وليس دليلاً على اكتماله أو تشغيل مرافق محددة؛ تحقق من الإعلان الحالي للمرفق الذي تنوي زيارته.'
  }
];

const timelineEn = [
  {
    tag: 'Site background',
    title: 'Location of the modern park',
    body: 'According to the municipality’s description and the city platform, the park is located in Al-Hadīqah district, south of the Prophet’s Mosque. The park is a modern urban facility; we do not attribute to it the history of an archaeological landmark or a neighbouring farm.'
  },
  {
    tag: 'A social destination',
    title: 'From a local park to a cultural destination',
    body: 'The Municipality of the Madinah Region mentions the park among the prominent social and cultural destinations, as it brings together green areas with heritage-style buildings, an artificial lake, play areas, and sports and cultural facilities, in addition to its proximity to Souq Al-Ainiah, the heritage district and the city arts centre mentioned on the “Madinah” platform.'
  },
  {
    tag: 'Completed development works',
    title: 'Upgrading the car parks, paths and green areas',
    body: 'The municipality published upgrade works that included raising the number of main car parks to eight, with an area of about 20,000 m², along with side car parks, pedestrian paths covering about 10,000 m², tree planting and scene-improvement works, in addition to illuminated guidance signs and display screens to serve visitors.'
  },
  {
    tag: 'A broader phase announced by the municipality',
    title: 'Developing the park within the central parks',
    body: 'As part of packages of municipal projects launched in 2023, the municipality mentions a project to develop and complete King Fahd Central Park in the south of the city over an area of 1.6 million square metres. This is a description of a project’s scope and is not proof of its completion or of the operation of specific facilities; check the current announcement for the facility you intend to visit.'
  }
];

const facts = isEn ? factsEn : factsAr;
const timeline = isEn ? timelineEn : timelineAr;
---
<section id={isEn ? 'history' : 'التاريخ'} class="bg-white py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[.6fr_1.4fr]">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="text-sm font-black text-gold-600">{isEn ? 'Site background and development' : 'خلفية المكان وتطوره'}</p>
        <h2 class="mt-3 text-4xl font-black leading-tight text-palm-900 sm:text-5xl">{isEn ? 'The modern park and its dated development descriptions' : 'الحديقة الحديثة وأوصاف تطويرها المؤرخة'}</h2>
        <p class="mt-5 text-lg leading-9 text-palm-900/70">{isEn ? 'Here we separate the historical context of the area from what is documented about the modern park itself, so that the long-standing heritage is not confused with contemporary development.' : 'نفصل هنا بين السياق التاريخي للمنطقة وبين ما هو موثق عن الحديقة الحديثة نفسها، حتى لا يختلط الإرث العريق مع التطوير المعاصر.'}</p>
        <a class="mt-7 inline-flex rounded-full bg-palm-900 px-6 py-3 text-sm font-black text-white no-underline" href={isEn ? '#experience' : '#التجربة'}>{isEn ? 'Explore the visit experience' : 'استكشف تجربة الزيارة'}</a>
      </div>

      <div class="space-y-6">
        {timeline.map((item) => (
          <article class="rounded-[2rem] border border-palm-900/10 bg-sand-50 p-6 lg:p-8">
            <span class="inline-flex rounded-full bg-palm-900 px-3 py-1 text-[11px] font-black text-white">{item.tag}</span>
            <h3 class="mt-4 text-2xl font-black text-palm-900">{item.title}</h3>
            <p class="mt-3 text-base leading-9 text-palm-900/72">{item.body}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-6">
      {facts.map((fact) => (
        <div class="rounded-3xl bg-palm-900 p-5 text-white">
          <p class="text-2xl font-black text-gold-400" dir="ltr">{fact.num}</p>
          <p class="mt-2 text-sm leading-6 text-white/75">{fact.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
