---
// وسائل الوصول إلى الحديقة — بمعلومات عملية محايدة من دون أرقام خطوط ثابتة حتى لا يُرشد لمسار قد يتغير.
const modes = [
  {
    "icon": "📍",
    "title": "تحديد المكان الصحيح",
    "badge": "حي الحديقة",
    "steps": [
      "استخدم رابط المكان المثبت أو الاسم الكامل «حديقة الملك فهد المركزية» في المدينة المنورة، وليس حديقة أخرى تحمل اسم الملك فهد.",
      "رمز الموقع CJC4+2F والعنوان حي الحديقة، المدينة المنورة 42383. طابق المدخل مع اللوحات عند الوصول."
    ]
  },
  {
    "icon": "🚕",
    "title": "النقل من مكان إقامتك أو وصولك",
    "badge": "حسب نقطة البداية",
    "steps": [
      "خطط للنقل من المطار أو المحطة أو مقر الإقامة وفق الخدمة المتاحة لك وقتها. تحقق من الأجرة ونقطة الإنزال داخل تطبيق مقدم الخدمة أو قناته الرسمية.",
      "لا يثبت هذا الدليل وقت انتقال أو مسافة طريق أو توافراً مضموناً لسيارة أجرة."
    ]
  },
  {
    "icon": "🚌",
    "title": "الحافلات",
    "badge": "تحقق من المسار",
    "steps": [
      "راجع مشغل النقل للخط والموقف والجدول الحالي. لا نفترض أن هناك خطاً مباشراً إلى مدخل معين.",
      "تحقق من الجزء الأخير للمشي والعبور والظل وإمكانية الوصول؛ لا نضمن ممشى قصيراً أو متصلاً من أقرب موقف."
    ]
  },
  {
    "icon": "🚗",
    "title": "السيارة والمواقف",
    "badge": "مدخل مفتوح",
    "steps": [
      "تذكر الأمانة مواقف رئيسية وطولية في وصفها المؤرخ. تحقق من الموقف المفتوح والرسوم وقيود الفعاليات يوم زيارتك.",
      "اختر نقطة لقاء واضحة للعودة، ولا تقف خارج المواقع المسموحة."
    ]
  },
  {
    "icon": "🚶",
    "title": "المشي داخل الحديقة",
    "badge": "حسب القدرة",
    "steps": [
      "تصف المصادر الرسمية مسارات للمشي والجري والدراجات؛ اختر الجزء المفتوح المناسب لك.",
      "المسافة العامة جنوب المسجد النبوي ليست طول مسار مشي آمناً. قيّم العبور والطقس وساعات الدخول قبل ترتيب مشي من خارج الحديقة."
    ]
  }
];

const summary = [
  {
    "mode": "النقل من نقطة وصولك",
    "dist": "يتحدد بالمسار",
    "time": "تحقق وقت الرحلة"
  },
  {
    "mode": "المواقف والمدخل",
    "dist": "اختر الموقع المفتوح",
    "time": "حسب التشغيل"
  },
  {
    "mode": "الحافلات والمشي الأخير",
    "dist": "راجع المشغل",
    "time": "حسب الجدول"
  }
];
---
<section id="الوصول" class="bg-palm-900 py-16 text-white lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr]">
      <div>
        <p class="text-sm font-black text-gold-400">الوصول والخريطة</p>
        <h2 class="mt-3 text-4xl font-black sm:text-5xl">الوصول إلى المكان الصحيح وتخطيط الانتقال</h2>
        <div class="mt-7 space-y-5 text-sm leading-8 text-white/78"><p>تقع الحديقة في حي الحديقة بالمدينة المنورة. يذكر المصدر الرسمي أنها جنوب المسجد النبوي بنحو خمسة كيلومترات؛ هذا وصف جغرافي تقريبي وليس مسافة طريق أو زمن وصول.</p><p>طابق اسم المكان ورمز الموقع CJC4+2F مع رابط الخريطة، ثم تحقق من المدخل المفتوح ووسيلة النقل المناسبة لنقطة انطلاقك.</p></div>
        <div class="mt-8 overflow-hidden rounded-[2rem] bg-white shadow-2xl ring-1 ring-white/10">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6461.616883614993!2d39.6061752!3d24.4200407!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x15bdc08c81f9c289%3A0x3c32ee418fc8dbbc!2sKing%20Fahad%20Central%20Park!5e1!3m2!1sar!2ssa!4v1788420936620!5m2!1sar!2ssa&hl=ar&gl=sa"
            width="100%"
            height="360"
            style="border:0"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="خريطة حديقة الملك فهد المركزية في المدينة المنورة"
          ></iframe>
        </div>
      </div>

      <div class="space-y-4">
        {modes.map((m) => (
          <article class="rounded-3xl border border-white/10 bg-white/5 p-5 lg:p-6">
            <div class="flex min-w-0 flex-wrap items-start justify-between gap-3">
              <h3 class="flex items-center gap-2 text-lg font-black"><span aria-hidden="true">{m.icon}</span>{m.title}</h3>
              <span class="shrink-0 rounded-full bg-gold-400 px-3 py-1 text-[11px] font-black text-night-950">{m.badge}</span>
            </div>
            <ol class="mt-4 space-y-2 text-sm leading-7 text-white/78">
              {m.steps.map((s) => (
                <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400" aria-hidden="true"></span><span>{s}</span></li>
              ))}
            </ol>
          </article>
        ))}

        <div class="max-w-full overflow-x-auto rounded-3xl border border-white/10">
          <table class="w-full text-right text-sm">
            <thead class="bg-white/10 text-white">
              <tr><th class="px-4 py-3 font-black">الوسيلة</th><th class="px-4 py-3 font-black">المسافة التقريبية</th><th class="px-4 py-3 font-black">الزمن التقريبي</th></tr>
            </thead>
            <tbody class="divide-y divide-white/10 text-white/80">
              {summary.map((r) => (
                <tr><td class="px-4 py-3 font-black">{r.mode}</td><td class="px-4 py-3" dir="ltr">{r.dist}</td><td class="px-4 py-3" dir="ltr">{r.time}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
