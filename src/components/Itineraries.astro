---
// خطط زيارة مخصّصة حسب نوع الزائر + مسار عام نصف يوم / يوم كامل.
interface Props {
  lang?: 'ar' | 'en';
}
const { lang = 'ar' } = Astro.props;
const isEn = lang === 'en';

const byCrowdAr = [
  {
    "icon": "👨‍👩‍👧‍👦",
    "title": "عائلة مع أطفال",
    "duration": "خطة مرنة",
    "steps": [
      "تحقق من فتح منطقة اللعب وملاءمتها لعمر الطفل.",
      "اختر مساراً مفتوحاً مع استراحات بحسب قدرة المجموعة.",
      "راقب الأطفال قرب الماء والطرق، واتفق على نقطة لقاء.",
      "تحقق من الطعام ودورات المياه التي ستعتمدون عليها."
    ]
  },
  {
    "icon": "📸",
    "title": "التصوير والطبيعة",
    "duration": "حسب الضوء والدخول",
    "steps": [
      "تحقق من ساعات الدخول وحالة الطقس قبل اختيار وقت التصوير.",
      "صور المشاهد المتاحة من المسارات المسموحة.",
      "احترم خصوصية الزوار واطلب الموافقة لتصوير الأشخاص.",
      "لا تتجاوز حاجزاً للحصول على زاوية تصوير."
    ]
  },
  {
    "icon": "♿",
    "title": "كبار السن والكراسي المتحركة",
    "duration": "حسب الاحتياج",
    "steps": [
      "تحقق من المدخل والموقف ودورة المياه الملائمة.",
      "استفسر عن طبيعة السطح والمنحدرات والمقاعد في المسار المقصود.",
      "اختر جزءاً أقصر عند الحاجة وخطط للاستراحة والعودة.",
      "لا يفترض هذا الدليل وجود حلقة خالية من الدرج أو ظل متصل."
    ]
  }
];

const generalAr = [
  {
    "icon": "⏳",
    "title": "زيارة أقصر",
    "duration": "من دون زمن ثابت",
    "body": "اختر جزءاً مفتوحاً من الممشى واستراحة مناسبة، بعد التحقق من المدخل والعودة. لا يلزم جمع جميع المرافق في جولة واحدة."
  },
  {
    "icon": "🗓️",
    "title": "زيارة أوسع",
    "duration": "حسب التشغيل",
    "body": "أضف نشاطاً ثقافياً أو مرفقاً فقط إذا تأكد فتحه وسعره وساعاته. لا نفترض وجود فعالية أو إمكان الدخول مجدداً في الموعد نفسه."
  }
];

const byCrowdEn = [
  {
    "icon": "👨‍👩‍👧‍👦",
    "title": "Family with children",
    "duration": "Flexible plan",
    "steps": [
      "Check that the play area is open and suitable for the child's age.",
      "Choose an open route with rests according to the group's ability.",
      "Watch the children near the water and the roads, and agree on a meeting point.",
      "Check the food and the toilets you will rely on."
    ]
  },
  {
    "icon": "📸",
    "title": "Photography and nature",
    "duration": "Depends on light and entry",
    "steps": [
      "Check the entry hours and the weather conditions before choosing the photography time.",
      "Photograph the scenes available from the permitted paths.",
      "Respect the privacy of visitors and ask for consent to photograph people.",
      "Do not cross a barrier to get a photography angle."
    ]
  },
  {
    "icon": "♿",
    "title": "Older adults and wheelchairs",
    "duration": "Depends on need",
    "steps": [
      "Check the entrance, the parking, and the suitable toilet.",
      "Ask about the nature of the surface, the slopes, and the seating on the route you intend.",
      "Choose a shorter part when needed and plan for rest and return.",
      "This guide does not assume the existence of a stair-free loop or continuous shade."
    ]
  }
];

const generalEn = [
  {
    "icon": "⏳",
    "title": "Shorter visit",
    "duration": "Without a fixed time",
    "body": "Choose an open part of the walkway and a suitable rest, after checking the entrance and the return. It is not necessary to gather all the facilities in one round."
  },
  {
    "icon": "🗓️",
    "title": "Broader visit",
    "duration": "Depends on operation",
    "body": "Add a cultural activity or a facility only if its opening, price, and hours are confirmed. We do not assume there is an event or the possibility of re-entering at the same time."
  }
];

const byCrowd = isEn ? byCrowdEn : byCrowdAr;
const general = isEn ? generalEn : generalAr;
---
<section id={isEn ? 'plans' : 'خطط-حسب-الفئة'} class="bg-sand-50 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-black text-gold-600">{isEn ? 'Plans according to your type of visitors' : 'خطط حسب نوع زوارك'}</p>
      <h2 class="mt-3 text-4xl font-black text-palm-900 sm:text-5xl">{isEn ? 'Suggested routes for each category' : 'مسارات مقترحة لكل فئة'}</h2>
      <p class="mt-5 text-lg leading-9 text-palm-900/70">{isEn ? 'Three routes directed at different needs, followed by two general routes according to the time available for your visit.' : 'ثلاثة مسارات موجّهة لاحتياجات مختلفة، يليها مساران عامّان حسب الوقت المتاح لزيارتك.'}</p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {byCrowd.map((c) => (
        <article class="rounded-[2rem] border border-palm-900/10 bg-white p-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="flex items-center gap-2 text-xl font-black text-palm-900"><span aria-hidden="true">{c.icon}</span>{c.title}</h3>
            <span class="rounded-full bg-palm-900 px-3 py-1 text-[11px] font-black text-white">{c.duration}</span>
          </div>
          <ol class="mt-5 space-y-3">
            {c.steps.map((s, i) => (
              <li class="flex gap-3 text-sm leading-7 text-palm-900/72"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-gold-400 text-xs font-black text-night-950">{i + 1}</span><span>{s}</span></li>
            ))}
          </ol>
        </article>
      ))}
    </div>

    <div class="mt-6 grid gap-5 md:grid-cols-2">
      {general.map((g) => (
        <article class="flex items-start gap-4 rounded-[2rem] bg-palm-900 p-6 text-white">
          <span class="text-3xl" aria-hidden="true">{g.icon}</span>
          <div>
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="text-xl font-black">{g.title}</h3>
              <span class="rounded-full bg-white/15 px-3 py-1 text-[11px] font-black">{g.duration}</span>
            </div>
            <p class="mt-3 text-sm leading-8 text-white/80">{g.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
