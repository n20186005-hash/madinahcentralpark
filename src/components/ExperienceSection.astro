---
// تجربة الزيارة: مسار مقترح وأنواع أماكن تصوير وقواعد احترام — من دون تسمية منشآت.
const route = [
  { title: 'الوصول والمواقف', body: 'وجّه تطبيق الخرائط إلى «حديقة الملك فهد المركزية» أو الرمز CJC4+2F، واختر أحد المواقف الرئيسية القريبة من المدخل، واقرأ لوحات التوجيه عند الدخول.' },
  { title: 'نزهة على الممشى', body: 'امشِ في المسارات الرئيسية وسط المسطحات الخضراء والأشجار، وهي ممرات مناسبة أيضاً للجري الخفيف وركوب الدراجات في المناطق المخصصة.' },
  { title: 'البحيرة ومناطق الجلوس', body: 'توقّف عند البحيرة الاصطناعية والجلسات المحيطة بها للاستراحة، واختر موقعك بعيداً عن ممرات الدراجات الأساسية.' },
  { title: 'مرافق العائلة والأطفال', body: 'مع الأطفال، اتجه إلى مناطق الألعاب المخصصة داخل الحديقة، واحرص على إشراف مباشر خاصة في أوقات الذروة المسائية.' },
  { title: 'خدمات الطعام والفعاليات', body: 'قد تجد منطقة خدمات طعام ومقاهٍ أو فعاليات موسمية في نطاق الحديقة ومحيطها؛ تحقق من توفرها ذلك اليوم قبل الاعتماد عليها.' },
  { title: 'جولة الختام', body: 'مع انخفاض الحرارة بعد المغرب تصبح الجولة أكثر راحة؛ راقب ساعات الإغلاق المسائية المعلنة واخرج قبل نهايتها بوقت كاف.' }
];

const photoSpots = [
  'المداخل والبوابات وسط الخلفية الخضراء',
  'البحيرة الاصطناعية في الساعة الذهبية',
  'المسطحات الخضراء من زاوية منخفضة',
  'الممشى مع الإنارة المسائية',
  'سوق العينية والحي التراثي أثناء الفعاليات'
];

const dos = [
  'احترم خصوصية العائلات والزوار عند التصوير',
  'استخدم الحاويات وحافظ على نظافة المكان',
  'راقب الأطفال قرب المياه والطرقات والممرات',
  'اتبع لوحات التوجيه وممرات الدراجات المخصصة',
  'راجع جدول الفعاليات والمواعيد الموسمية (رمضان والأعياد)'
];

const donts = [
  'لا تكسر المسطحات الخضراء أو الأغصان أو تتلف المزروعات',
  'لا تشعل ناراً أو تشوياً إلا في المواقع المصرح بها (إن وُجدت)',
  'لا تقود الدراجة في مناطق المشاة المخصصة',
  'لا تترك ممتلكاتك دون مراقبة في الأماكن المزدحمة',
  'لا تصوّر أشخاصاً دون موافقتهم في الأجواء العائلية'
];
---
<section id="التجربة" class="bg-sand-50 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-black text-gold-600">دليل الاستمتاع بالزيارة</p>
      <h2 class="mt-3 text-4xl font-black text-palm-900 sm:text-5xl">تجربة زيارة مقترحة في نحو ساعتين إلى ثلاث</h2>
      <p class="mt-5 text-lg leading-9 text-palm-900/70">مسار مرن يناسب الأفراد والعائلات، ويستغرق تعديله بحسب ما هو متاح فعلاً في يوم زيارتك من فعاليات وخدمات.</p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1.25fr_.75fr]">
      <ol class="space-y-4">
        {route.map((step, index) => (
          <li class="flex gap-4 rounded-3xl border border-palm-900/10 bg-white p-5 lg:p-6">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-palm-900 text-lg font-black text-gold-400">{index + 1}</span>
            <div>
              <h3 class="text-lg font-black text-palm-900">{step.title}</h3>
              <p class="mt-2 text-sm leading-8 text-palm-900/68">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="space-y-6">
        <article class="rounded-[2rem] border border-palm-900/10 bg-white p-6">
          <h3 class="text-xl font-black text-palm-900">📸 أماكن تصوير عامة</h3>
          <ul class="mt-4 space-y-3">
            {photoSpots.map((spot) => (
              <li class="flex items-start gap-3 text-sm leading-7 text-palm-900/72"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-gold-400" aria-hidden="true"></span>{spot}</li>
            ))}
          </ul>
        </article>

        <article class="rounded-[2rem] bg-palm-900 p-6 text-white">
          <h3 class="text-xl font-black">✅ نصائح يحترمها الزوار</h3>
          <ul class="mt-4 space-y-3">
            {dos.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-7 text-white/82"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-gold-400" aria-hidden="true"></span>{item}</li>
            ))}
          </ul>
        </article>

        <article class="rounded-[2rem] border border-clay-500/30 bg-clay-500/10 p-6">
          <h3 class="text-xl font-black text-clay-500">⚠️ سلوكيات يُنصح بتجنبها</h3>
          <ul class="mt-4 space-y-3">
            {donts.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-7 text-palm-900/72"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-clay-500" aria-hidden="true"></span>{item}</li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>
