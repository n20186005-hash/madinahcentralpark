---
// خدمات ومرافق بوصفها أنواعاً فقط (من دون أسماء منشآت)، انسجاماً مع الطابع الإرشادي غير الربحي للمشروع.
const facilities = [
  { icon: '🅿️', title: 'مواقف السيارات', note: 'داخل الحديقة', body: 'تذكر أمانة المنطقة ثمانية مواقف رئيسية بمساحة إجمالية تقارب 20,000 م² إضافة إلى مواقف جانبية، مع أفضليات للعائلات وكبار السن بحسب التصميم؛ في الفعاليات الكبيرة يُفضّل الحضور مبكراً.' },
  { icon: '🚻', title: 'دورات المياه العامة', note: 'داخل الحديقة', body: 'مرافق خدمات عامة متوقعة ضمن نطاق الحديقة عند المداخل الرئيسية ومناطق الخدمة؛ يُنصح بالسؤال عنها عند الدخول لأن مواقعها تختلف بعد التطوير.' },
  { icon: '🧒', title: 'مناطق ألعاب الأطفال', note: 'داخل الحديقة', body: 'مساحات مخصصة للعب وُصفت في مصادر الأمانة بأنها تلائم الأطفال، وتشمل مناطق رملية وخضراء مجهزة للهو والإشراف العائلي.' },
  { icon: '🚶', title: 'مسارات الحركة والرياضة', note: 'داخل الحديقة', body: 'مسارات للمشي والجري وركوب الدراجات، ومساحات رياضية ولياقة، إضافة إلى مسارات مشاة بلغت مساحتها نحو 10,000 م² حسب المنشور المحلي.' },
  { icon: '🍽️', title: 'المطاعم والمقاهي', note: 'داخل الحديقة ومحيطها', body: 'توجد عادةً منطقة خدمات طعام وفعاليات داخل النطاق، وتتوفر قرب الحديقة أنواع مطاعم عائلية ومقاهٍ ووجبات سريعة؛ نكتفي بذكر الأنواع دون تسمية محلات.' },
  { icon: '🏨', title: 'أماكن الإقامة', note: 'محيط قريب', body: 'توفّر أحياء جنوب المدينة أنواعاً متعددة للإقامة تشمل فنادق وشققاً فندقية واستراحات. لا نرشّح منشأة بعينها؛ استخدم منصات الحجز أو الخرائط لاختيار ما يناسبك.' },
  { icon: '🛒', title: 'التسوق والتموين', note: 'محيط قريب', body: 'يمكن شراء مستلزمات النزهة والماء والوجبات الخفيفة من أسواق وبقالات في الأحياء القريبة؛ أسماء هذه المتاجر وأنواعها عرضة للتغير، فنكتفي بذكر النوع.' },
  { icon: '⛽', title: 'محطات الوقود وشحن السيارات', note: 'على الطرق المؤدية', body: 'توجد محطات وقود وخدمات سيارات على الطرق الرئيسية المؤدية إلى الحي، وبعضها يوفّر شحناً كهربائياً. حدّد الأقرب إليك عبر تطبيق الخرائط قبل الانطلاق.' },
  { icon: '💊', title: 'الصيدليات والرعاية الصحية', note: 'محيط قريب', body: 'صيدليات ومراكز رعاية صحية أولية متاحة في أحياء المدينة الجنوبية. أرقام الطوارئ ومراكز الخدمة الرسمية تبقى المصدر الأدق عند الحاجة.' },
  { icon: '🏦', title: 'الصراف الآلي والخدمات البنكية', note: 'محيط قريب', body: 'أجهزة صراف آلي متوقعة قرب المراكز التجارية في المنطقة؛ لا تُعتمد داخل الحديقة نفسها غالباً، لذا يُنصح بتأمين ما تحتاجه مسبقاً.' },
  { icon: '🕌', title: 'المساجد ودور الوضوء', note: 'محيط قريب', body: 'تتوزع المساجد في الأحياء المجاورة للحديقة، وقرب طريق قباء التاريخي. يسهل تحديد أقرب مسجد من تطبيق الخرائط، خاصة قبل الصلوات.' },
  { icon: '♿', title: 'إمكانية الوصول والاستيعاب', note: 'نصيحة عملية', body: 'توفر الأرصفة والممرات الواسعة سهولة نسبية للتنقل، لكن يُنصح بالتحقق من المداخل والمرافق المناسبة لذوي الإعاقة وكبار السن لدى الجهة الرسمية أو من الموقع الفعلي، وتتفاوت الطاقة الاستيعابية وقت الفعاليات.' }
];
---
<section id="المرافق" class="bg-sand-50 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[.65fr_1.35fr] lg:items-end">
      <div>
        <p class="text-sm font-black text-gold-600">الخدمات والمرافق</p>
        <h2 class="mt-3 text-4xl font-black text-palm-900 sm:text-5xl">كل ما يهمك قبل الزيارة</h2>
      </div>
      <p class="text-lg leading-9 text-palm-900/70">نوضّح هنا أنواع الخدمات المتوقعة داخل الحديقة أو في نطاقها القريب بصياغة محايدة ومن دون ذكر أسماء محلات أو علامات تجارية، لأن قوائم الأعمال تتغير ولا يجوز أن يتحول هذا الدليل المستقل إلى توصية إعلانية.</p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {facilities.map((item) => (
        <article class="flex flex-col rounded-[2rem] border border-palm-900/10 bg-white p-6">
          <div class="flex items-start justify-between gap-3">
            <span class="text-3xl" aria-hidden="true">{item.icon}</span>
            <span class="rounded-full border border-palm-900/10 bg-sand-50 px-3 py-1 text-[11px] font-black text-palm-900/60">{item.note}</span>
          </div>
          <h3 class="mt-4 text-xl font-black text-palm-900">{item.title}</h3>
          <p class="mt-3 text-sm leading-8 text-palm-900/68">{item.body}</p>
        </article>
      ))}
    </div>

    <div class="mt-8 rounded-3xl border border-gold-400/40 bg-gold-400/10 p-5 text-sm leading-8 text-palm-900/75">
      <strong class="font-black">ملاحظة الحياد:</strong> القائمة أعلاه تصف <em>أنواع الخدمات</em> فقط من دون تسمية أي منشأة أو محافظة على توصية تجارية. المعلومات داخل الحديقة مستندة إلى ما تنشره أمانة منطقة المدينة المنورة، وما حولها من أحياء قريبة يظهر على تطبيقات الخرائط وقد يتغير مع الوقت.
    </div>
  </div>
</section>
