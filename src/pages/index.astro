---
import BaseLayout from '../layouts/BaseLayout.astro';
import FacilitiesSection from '../components/FacilitiesSection.astro';
import Weather from '../components/Weather.astro';
import HistorySection from '../components/HistorySection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import TransportSection from '../components/TransportSection.astro';
import SeasonalStrategy from '../components/SeasonalStrategy.astro';
import Itineraries from '../components/Itineraries.astro';
import VisitorResponsibility from '../components/VisitorResponsibility.astro';

const siteUrl = Astro.site ? new URL('/', Astro.site).href : undefined;
const heroUrl = Astro.site ? new URL('/images/park-concept.svg', Astro.site).href : undefined;
const entityId = siteUrl ? `${siteUrl}#king-fahad-central-park` : undefined;

const faqs = [
  [
    "أين تقع حديقة الملك فهد المركزية؟",
    "في حي الحديقة بالمدينة المنورة، الرمز البريدي 42383 ورمز الموقع CJC4+2F. تصف منصة المدينة موقعها جنوب المسجد النبوي بنحو خمسة كيلومترات؛ هذه معلومة موقع عام وليست طول طريق مشي. افتح رابط المكان للتحقق من المدخل والمسار."
  ],
  [
    "ما مواعيد زيارة الحديقة؟",
    "في لقطة خرائط Google بتاريخ 25 أكتوبر 2026 ظهر المكان مفتوحاً 24 ساعة طوال الأسبوع. لكن صفحة منصة المدينة التابعة لهيئة تطوير المنطقة تصف الزيارة اليومية في الفترة المسائية فقط، من دون ساعات رقمية. تحقق من اللوحات والجهة المشغلة؛ لا تعني بطاقة المكان أن جميع المرافق أو الفعاليات تعمل طوال اليوم."
  ],
  [
    "هل تتغير المواعيد في رمضان والأعياد؟",
    "قد تكون للفعالية أو المرفق مواعيد مستقلة. لا تتوفر هنا ساعات موسمية مؤكدة؛ راجع الإعلان الحالي للمنظم قبل ترتيب الزيارة."
  ],
  [
    "هل يوجد ممشى؟",
    "تذكر أمانة المدينة في منشور 9 سبتمبر 2024 مسارات للمشي والجري والدراجات. اختر الجزء المفتوح المناسب لقدرتك واتبع فصل مسارات الدراجات والمشاة ولوحات الموقع."
  ],
  [
    "أين أجد صور الحديقة؟",
    "تعرض الصفحة رسماً أصلياً توضيحياً، وليس صورة أو خريطة للموقع. راجع بطاقة المكان على الخرائط لصور الزوار الأحدث؛ الصور لا تثبت تشغيل كل مرفق اليوم."
  ],
  [
    "هل الدخول مجاني؟",
    "لا تحدد الصفحات الرسمية التي راجعناها تعرفة دخول عامة حالية. غياب السعر لا يثبت مجانية الدخول؛ اسأل عن الدخول والفعالية والخدمات كل على حدة."
  ],
  [
    "ما تقييمها على الخرائط؟",
    "في 25 أكتوبر 2026 عرضت خرائط Google تقييماً 4.2 من 5 من 25,678 تقييماً. هذه لقطة لطرف ثالث قابلة للتغير، وليست تقييماً جمعه هذا الدليل."
  ],
  [
    "هل توجد مواقف؟",
    "وثقت الأمانة في 2024 ثمانية مواقف رئيسية بمساحة إجمالية 20 ألف متر مربع، ومواقف طولية إضافية. تحقق من الموقف والمدخل المفتوحين يوم الزيارة؛ لا نضمن مساحة شاغرة."
  ],
  [
    "كم تستغرق الزيارة؟",
    "اختر مدة تناسب المسار المفتوح واحتياجات مجموعتك، وأضف وقتاً للاستراحة. لا يحدد هذا الدليل زمناً إلزامياً لجولة أو مسافة داخلية لم يتم قياسها."
  ],
  [
    "هل تناسب الأطفال؟",
    "تذكر منصة المدينة والأمانة مناطق لعب وجلوس ومرافق ثقافية ورياضية. تحقق من فتح النشاط وملاءمته لعمر الطفل وأشرف عليه قرب الماء والطرق."
  ],
  [
    "ما الوقت الأنسب؟",
    "وازن بين ساعات الدخول المؤكدة والطقس الفعلي وقدرتك على المشي. تصف منصة المدينة الزيارة المسائية، لكن ذلك ليس ضماناً لراحة الطقس أو لعمل كل نشاط."
  ],
  [
    "هل توجد جلسات؟",
    "تذكر المصادر الرسمية أماكن للجلوس ومساحات خضراء. لا يضمن ذلك جلسة شاغرة أو مساراً مظللاً متصلاً؛ تحقق عند الوصول."
  ],
  [
    "هل يمكن ممارسة الرياضة؟",
    "تذكر المصادر مسارات للمشي والجري والدراجات. استخدم المسار المسموح واتبع اللوحات؛ لا نفترض توفر تأجير معدات أو برنامج رياضي في موعد معين."
  ],
  [
    "هل الوصول مناسب للكراسي المتحركة؟",
    "تُظهر بطاقة الخرائط رمز مدخل مهيأ، لكنه لا يثبت أن جميع المسارات والمرافق متاحة. تحقق من المدخل والموقف ودورة المياه وطبيعة السطح بحسب احتياجك قبل الزيارة."
  ],
  [
    "هل تتوفر مياه شرب ووضوء؟",
    "لم نتحقق من مواقع أو ساعات مياه الشرب والوضوء ودورات المياه الحالية. اسأل عند الوصول واحمل ماءك؛ لا تعتمد على خدمة غير مؤكدة."
  ],
  [
    "هل يمكن دمجها مع زيارة أخرى؟",
    "يمكن تخطيط زيارة منفصلة لأماكن أخرى في المدينة وفق مواعيدها ووسيلة نقلك. قربها الجغرافي العام لا يثبت وجود ممشى متصل أو وقت انتقال محدد."
  ],
  [
    "متى تقام الفعاليات؟",
    "تصف المصادر فعاليات ثقافية وترفيهية تاريخية، لكن هذا لا يثبت وجود فعالية اليوم. راجع إعلاناً مؤرخاً للمنظم والمكان وسعره وساعاته."
  ]
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  ...(entityId ? { '@id': entityId } : {}),
  name: 'حديقة الملك فهد المركزية',
  alternateName: [
    'حديقة الملك فهد',
    'King Fahad Central Park',
    'Madinah Central Park',
    'Central Park Madinah',
    'حديقة المدينة المركزية'
  ],
  description: 'حديقة حضرية واسعة في المدينة المنورة تجمع المساحات الخضراء ومسارات المشي والجري والدراجات ومناطق الأطفال والمرافق الثقافية والترفيهية والبحيرة الاصطناعية.',
  ...(siteUrl ? { url: siteUrl } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'حي الحديقة',
    addressLocality: 'المدينة المنورة',
    addressRegion: 'منطقة المدينة المنورة',
    postalCode: '42383',
    addressCountry: 'SA'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 24.4200407,
    longitude: 39.6061752
  },
  containedInPlace: {
    '@type': 'AdministrativeArea',
    name: 'منطقة المدينة المنورة'
  },
  hasMap: 'https://maps.app.goo.gl/o2EdMT6dC5qwHHun7',
  sameAs: [
    'https://maps.app.goo.gl/o2EdMT6dC5qwHHun7',
    'https://visitmadinahsa.com/sa-ar/destinations/حديقة-الملك-فهد',
    'https://www.amana-md.gov.sa/NewsCenter/Details/2396'
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
};

const breadcrumbSchema = siteUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'حديقة الملك فهد المركزية', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'المدينة المنورة', item: 'https://visitmadinahsa.com/sa-ar' },
        { '@type': 'ListItem', position: 3, name: 'منطقة المدينة المنورة', item: 'https://www.amana-md.gov.sa' },
        { '@type': 'ListItem', position: 4, name: 'المملكة العربية السعودية', item: 'https://www.visitsaudi.com/ar' }
      ]
    }
  : undefined;

const pageTitle = 'حديقة الملك فهد المركزية بالمدينة المنورة: المواعيد والموقع والصور';
const pageDesc = 'دليل زيارة حديقة الملك فهد المركزية بالمدينة المنورة: المواعيد، الموقع على الخريطة، الممشى، المواقف، الأنشطة، الصور ونصائح الزيارة قبل الذهاب.';
const pageDate = '2026-10-25';

const graphSchema = siteUrl
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': `${siteUrl}#organization`,
          name: 'دليل حديقة الملك فهد المركزية',
          url: siteUrl,
          logo: {
            '@type': 'ImageObject',
            '@id': `${siteUrl}#organization-logo`,
            url: new URL('/favicon.svg', Astro.site).href,
            width: 64,
            height: 64
          }
        },
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}#website`,
          url: siteUrl,
          name: 'دليل حديقة الملك فهد المركزية – المدينة المنورة',
          inLanguage: 'ar-SA',
          publisher: { '@id': `${siteUrl}#organization` },
          about: { '@id': entityId }
        },
        {
          '@type': 'WebPage',
          '@id': `${siteUrl}#webpage`,
          url: siteUrl,
          name: pageTitle,
          description: pageDesc,
          inLanguage: 'ar-SA',
          isPartOf: { '@id': `${siteUrl}#website` },
          about: { '@id': entityId },
          primaryImageOfPage: { '@type': 'ImageObject', '@id': `${siteUrl}#hero-image`, url: heroUrl },
          dateModified: pageDate
        }
      ]
    }
  : undefined;
---
<BaseLayout
  title={pageTitle}
  description={pageDesc}
  jsonLd={[attractionSchema, faqSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...(graphSchema ? [graphSchema] : [])]}
>
  <section class="relative isolate overflow-hidden bg-night-950 text-white">
    <div class="park-hero-background absolute inset-0 z-0">
      <div class="photo-frame h-full w-full">
        <div class="photo-fallback"><span class="max-w-md text-sm leading-7 opacity-85">رسم توضيحي أصلي، وليس صورة للموقع.</span></div>
        <img src="/images/park-concept.svg" alt="رسم أصلي توضيحي لحديقة حضرية؛ ليس صورة للموقع" width="1600" height="900" fetchpriority="high" onerror="this.style.display='none'" />
      </div>
      <div class="absolute inset-0 z-10 bg-gradient-to-l from-night-950/96 via-night-950/70 to-palm-900/30"></div>
      <div class="absolute inset-x-0 bottom-0 z-10 h-36 bg-gradient-to-t from-night-950 to-transparent"></div>
    </div>
    <div class="park-hero-content relative z-10 mx-auto grid min-h-[76vh] max-w-7xl items-end gap-8 px-5 pb-16 pt-28 lg:grid-cols-[1.1fr_.55fr] lg:px-8 lg:pb-24">
      <div>
        <p class="mb-5 inline-flex rounded-full border border-white/25 bg-white/10 px-4 py-2 text-sm font-black backdrop-blur">حي الحديقة · المدينة المنورة · المملكة العربية السعودية</p>
        <h1 class="max-w-4xl text-5xl font-black leading-[1.2] tracking-tight sm:text-7xl">حديقة الملك فهد المركزية <span class="mt-3 block text-3xl font-black leading-snug text-gold-400 sm:text-4xl">في المدينة المنورة</span></h1>
        <p class="mt-6 max-w-3xl text-xl leading-10 text-sand-100/92">واحة حضرية واسعة تجمع الأشجار والظلال ومسارات الحركة والمرافق العائلية والثقافية، على مسافة تقارب خمسة كيلومترات جنوب المسجد النبوي.</p>
        <div class="mt-7 flex flex-wrap gap-3 text-sm font-black">
          <span class="rounded-full bg-gold-400 px-4 py-2 text-night-950">خرائط Google: <bdi dir="ltr">4.2 / 5 · 25,678</bdi> · 25 أكتوبر 2026</span>
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2">حديقة عامة</span>
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2">CJC4+2F</span>
        </div>
      </div>
      <aside class="rounded-[2rem] border border-white/15 bg-white/10 p-6 backdrop-blur-xl">
        <p class="text-sm font-black text-gold-400">بيانات الموقع</p>
        <dl class="mt-5 space-y-5 text-sm leading-7">
          <div><dt class="font-black text-white">العنوان</dt><dd class="text-sand-100/80">حي الحديقة، المدينة المنورة 42383، المملكة العربية السعودية</dd></div>
          <div><dt class="font-black text-white">الإحداثيات</dt><dd class="text-sand-100/80" dir="ltr">24.4200407, 39.6061752</dd></div>
          <div><dt class="font-black text-white">الزيارة</dt><dd class="text-sand-100/80">لقطة خرائط 25 أكتوبر 2026: 24 ساعة؛ منصة المدينة تصف المساء. تحقق من الدخول الحالي.</dd></div>
        </dl>
        <a href="https://maps.app.goo.gl/o2EdMT6dC5qwHHun7" target="_blank" rel="noopener noreferrer" class="mt-6 block rounded-full bg-white px-5 py-3 text-center font-black text-palm-900 no-underline">الاتجاهات عبر خرائط Google</a>
      </aside>
    </div>
  </section>

  <p class="bg-sand-50 px-5 py-3 text-center text-sm leading-7">الرسم: عمل أصلي لهذا الدليل، أكتوبر 2026؛ ليس صورة لحديقة الملك فهد أو خريطة للمداخل.</p>

  <section class="border-b border-palm-900/10 bg-palm-900 py-10 text-white lg:py-12">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <p class="text-sm font-black text-gold-400">معلومات سريعة</p>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <li class="flex items-start gap-3 rounded-2xl bg-white/5 p-4"><span class="text-2xl" aria-hidden="true">📍</span><div><p class="font-black">الموقع</p><p class="mt-1 text-sm leading-7 text-sand-100/80">حي الحديقة، المدينة المنورة</p></div></li>
        <li class="flex items-start gap-3 rounded-2xl bg-white/5 p-4"><span class="text-2xl" aria-hidden="true">🕓</span><div><p class="font-black">المواعيد</p><p class="mt-1 text-sm leading-7 text-sand-100/80"><a class="text-gold-400 no-underline hover:underline" href="#مواعيد-الزيارة">اقرأ اختلاف المصادر وتحقق من الدخول الحالي</a></p></div></li>
        <li class="flex items-start gap-3 rounded-2xl bg-white/5 p-4"><span class="text-2xl" aria-hidden="true">🎟️</span><div><p class="font-black">رسوم الدخول</p><p class="mt-1 text-sm leading-7 text-sand-100/80">تحقق من الرسوم الحالية للفعاليات والمرافق</p></div></li>
        <li class="flex items-start gap-3 rounded-2xl bg-white/5 p-4"><span class="text-2xl" aria-hidden="true">🚗</span><div><p class="font-black">مواقف السيارات</p><p class="mt-1 text-sm leading-7 text-sand-100/80">موصوفة في منشور الأمانة 2024؛ تحقق من المتاح</p></div></li>
        <li class="flex items-start gap-3 rounded-2xl bg-white/5 p-4"><span class="text-2xl" aria-hidden="true">🚶</span><div><p class="font-black">ممشى</p><p class="mt-1 text-sm leading-7 text-sand-100/80"><a class="text-gold-400 no-underline hover:underline" href="#المرافق">مسارات للمشي والجري</a></p></div></li>
        <li class="flex items-start gap-3 rounded-2xl bg-white/5 p-4"><span class="text-2xl" aria-hidden="true">🗺️</span><div><p class="font-black">الاتجاهات</p><p class="mt-1 text-sm leading-7 text-sand-100/80"><a class="text-gold-400 no-underline hover:underline" href="https://maps.app.goo.gl/o2EdMT6dC5qwHHun7" target="_blank" rel="noopener noreferrer">عرض على خرائط Google</a></p></div></li>
      </ul>
    </div>
  </section>

  <section id="عن-الحديقة" class="leaf-divider border-b border-palm-900/10 bg-sand-50 py-16 lg:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[1.05fr_.7fr] lg:px-8">
      <div>
        <nav aria-label="مسار الانتماء الجغرافي" class="flex flex-wrap items-center gap-2 text-xs font-black text-palm-900/55">
          <span>حديقة الملك فهد المركزية</span>
          <span aria-hidden="true">›</span>
          <span>المدينة المنورة</span>
          <span aria-hidden="true">›</span>
          <span>منطقة المدينة المنورة</span>
          <span aria-hidden="true">›</span>
          <span>المملكة العربية السعودية</span>
        </nav>
        <p class="text-sm font-black text-gold-600 mt-4">معلم أخضر في المدينة المنورة</p>
        <h2 class="mt-3 text-4xl font-black leading-tight text-palm-900 sm:text-5xl">حديقة كبيرة بطابع اجتماعي وثقافي</h2>
        <div class="mt-7 space-y-5 text-lg leading-9 text-palm-900/75">
          <p>تُعدّ حديقة الملك فهد المركزية الحديقة المركزية الكبرى في المدينة المنورة، والمعروفة بالإنجليزية باسم «Madinah Central Park»، وهي الوجهة التي يرمز إليها النطاق madinahcentralpark.com. تقع في قلب المدينة المنورة وتعتبر محوراً رئيسياً لزوار المنطقة.</p>
          <p>تصف أمانة منطقة المدينة المنورة حديقة الملك فهد المركزية بأنها إحدى الوجهات الاجتماعية والثقافية البارزة في المدينة، وتجمع بين مساحات خضراء واسعة ومبانٍ ذات طابع تراثي ومرافق للحركة والاستراحة.</p>
          <p>وتشمل عناصرها المذكورة في المصادر المحلية مسارات للمشي والجري وركوب الدراجات، ومناطق ألعاب للأطفال، وجلسات، وبحيرة اصطناعية، ومساحات ثقافية، ومرافق للفروسية والطعام، إضافة إلى سوق العينية والحي التراثي ومركز فنون المدينة.</p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-full bg-palm-900 px-5 py-3 text-sm font-black text-white no-underline" href="#خطط-للزيارة">خطط للزيارة</a>
          <a class="rounded-full border border-palm-900/15 bg-white px-5 py-3 text-sm font-black text-palm-900 no-underline" href="#المصادر">المصادر الرسمية</a>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <article class="rounded-[2rem] bg-palm-900 p-6 text-white"><div class="text-3xl">🌿</div><h3 class="mt-4 text-xl font-black">مساحات خضراء</h3><p class="mt-2 text-sm leading-7 text-white/75">أشجار وظلال ومساحات مفتوحة مناسبة للتنزه والاستراحة.</p></article>
        <article class="rounded-[2rem] border border-palm-900/10 bg-white p-6"><div class="text-3xl">🚶</div><h3 class="mt-4 text-xl font-black">مسارات حركة</h3><p class="mt-2 text-sm leading-7 text-palm-900/65">مسارات للمشي والجري وركوب الدراجات ضمن بيئة الحديقة.</p></article>
        <article class="rounded-[2rem] border border-palm-900/10 bg-white p-6"><div class="text-3xl">👨‍👩‍👧‍👦</div><h3 class="mt-4 text-xl font-black">مساحات عائلية</h3><p class="mt-2 text-sm leading-7 text-palm-900/65">ألعاب للأطفال وجلسات ومرافق مناسبة للزيارات العائلية.</p></article>
