---
// خدمات ومرافق بوصفها أنواعاً فقط (من دون أسماء منشآت)، انسجاماً مع الطابع الإرشادي غير الربحي للمشروع.
interface Props {
  lang?: 'ar' | 'en';
}
const { lang = 'ar' } = Astro.props;
const isEn = lang === 'en';

const facilitiesAr = [
  {
    "icon": "🅿️",
    "title": "مواقف السيارات",
    "note": "وصف مؤرخ",
    "body": "وثقت الأمانة في 9 سبتمبر 2024 ثمانية مواقف رئيسية ومواقف طولية. تحقق من المدخل المفتوح والموقف المناسب؛ لا نضمن توافر مكان."
  },
  {
    "icon": "🚻",
    "title": "دورات المياه والمياه",
    "note": "تحقق قبل الاعتماد",
    "body": "اسأل عن موقع دورة المياه ومياه الشرب وساعاتها ومدى ملاءمتها لاحتياجك. لا يثبت هذا الدليل توفرها عند كل مدخل."
  },
  {
    "icon": "🧒",
    "title": "ألعاب الأطفال",
    "note": "مصادر رسمية",
    "body": "تذكر الأمانة ومنصة المدينة مناطق للأطفال. تحقق من فتح اللعبة والسن المناسب وأشرف على الطفل؛ وصف المنطقة لا يضمن عمل كل جهاز."
  },
  {
    "icon": "🚶",
    "title": "الممشى والرياضة",
    "note": "مصادر رسمية",
    "body": "تصف المصادر مسارات للمشي والجري والدراجات. اتبع المسار المسموح والإرشادات، واختر مسافة تناسب قدرتك والطقس."
  },
  {
    "icon": "🍽️",
    "title": "الطعام والشراب",
    "note": "تحقق من التشغيل",
    "body": "تذكر منصة المدينة مطاعم ضمن المرافق. تحقق من اسم المنشأة المفتوحة وساعاتها وسعرها؛ لا توجد هنا قائمة تجارية موثقة لفروع بعينها."
  },
  {
    "icon": "♿",
    "title": "سهولة الوصول",
    "note": "احتياج فردي",
    "body": "رمز المدخل المهيأ في الخرائط ليس تقييماً لجميع المسارات. تحقق من الموقف والمدخل والسطح ودورة المياه المناسبة قبل الزيارة."
  }
];

const facilitiesEn = [
  {
    "icon": "🅿️",
    "title": "Car parks",
    "note": "Archived description",
    "body": "On 9 September 2024 the municipality documented eight main car parks and parallel parking. Check which entrance is open and which spot suits you; we do not guarantee a space will be available."
  },
  {
    "icon": "🚻",
    "title": "Restrooms and water",
    "note": "Verify before relying on it",
    "body": "Ask about the location of restrooms and drinking water, their hours and how well they suit your needs. This guide does not prove they are available at every entrance."
  },
  {
    "icon": "🧒",
    "title": "Children's play areas",
    "note": "Official sources",
    "body": "The municipality and the city platform mention children's areas. Check that the equipment is open and the age it suits, and supervise your child; describing the area does not guarantee that every piece of equipment works."
  },
  {
    "icon": "🚶",
    "title": "Walkway and sports",
    "note": "Official sources",
    "body": "The sources describe paths for walking, running and cycling. Follow the permitted path and the guidance, and choose a distance that suits your ability and the weather."
  },
  {
    "icon": "🍽️",
    "title": "Food and drink",
    "note": "Check operation",
    "body": "The city platform mentions restaurants among the facilities. Check the name of the establishment that is open, its hours and its price; there is no documented commercial list of specific branches here."
  },
  {
    "icon": "♿",
    "title": "Accessibility",
    "note": "Individual need",
    "body": "The accessible-entrance icon on maps is not an assessment of all routes. Before your visit, check the parking, the entrance, the surface and a suitable restroom."
  }
];

const facilities = isEn ? facilitiesEn : facilitiesAr;
---
<section id={isEn ? 'facilities' : 'المرافق'} class="bg-sand-50 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[.65fr_1.35fr] lg:items-end">
      <div>
        <p class="text-sm font-black text-gold-600">{isEn ? 'Facilities and services' : 'الخدمات والمرافق'}</p>
        <h2 class="mt-3 text-4xl font-black text-palm-900 sm:text-5xl">{isEn ? 'Everything you need before you visit' : 'كل ما يهمك قبل الزيارة'}</h2>
      </div>
      <p class="text-lg leading-9 text-palm-900/70">{isEn ? 'We distinguish between the facilities described by official sources and services that should be verified on the day of your visit. Dated development descriptions do not guarantee that every facility is operating now.' : 'نميز بين المرافق التي وصفتها المصادر الرسمية وبين خدمات ينبغي التحقق منها يوم الزيارة. أوصاف التطوير المؤرخة لا تضمن تشغيل كل مرفق الآن.'}</p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {facilities.map((item) => (
        <article class="flex flex-col rounded-[2rem] border border-palm-900/10 bg-white p-6">
          <div class="flex items-start justify-between gap-3">
            <span class="text-3xl" aria-hidden="true">{item.icon}</span>
            <span class="rounded-full border border-palm-900/10 bg-sand-50 px-3 py-1 text-[11px] font-black text-palm-900/60">{item.note}</span>
          </div>
          <h3 class="mt-4 text-xl font-black text-palm-900">{item.title}</h3>
          <p class="mt-3 text-sm leading-8 text-palm-900/68">{item.body}</p>
        </article>
      ))}
    </div>

    <div class="mt-8 rounded-3xl border border-gold-400/40 bg-gold-400/10 p-5 text-sm leading-8 text-palm-900/75">
      <strong class="font-black">{isEn ? 'Neutrality note:' : 'ملاحظة الحياد:'}</strong> {isEn ? 'The official descriptions referred to date back to the municipality’s post of 9 September 2024 and the city platform page. Check current services and fees with the operating authority.' : 'الأوصاف الرسمية المشار إليها تعود إلى منشور الأمانة في 9 سبتمبر 2024 وصفحة منصة المدينة. تحقق من الخدمات الحالية والرسوم عند الجهة المشغلة.'}
    </div>
  </div>
</section>
