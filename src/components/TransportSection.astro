---
// وسائل الوصول إلى الحديقة — بمعلومات عملية محايدة من دون أرقام خطوط ثابتة حتى لا يُرشد لمسار قد يتغير.
const modes = [
  {
    icon: '✈️',
    title: 'بالطائرة (مطار الأمير محمد بن عبدالعزيز)',
    badge: 'من المطار ~20 كم',
    steps: [
      'تصل الرحلات إلى مطار الأمير محمد بن عبدالعزيز الدولي (MED) شمال وسط المدينة بحسب المواد المنشورة للمطار.',
      'من صالة الوصول استخدم تطبيق توصيل (أوبر/كريم) أو سيارة أجرة من المرابطة أمام المحطة، واكتب الوجهة «حديقة الملك فهد المركزية» أو الرمز CJC4+2F.',
      'الرحلة إلى الحديقة تستغرق نحو 25–40 دقيقة حسب حركة المرور، ويفضّل الحجز داخل التطبيق لمعرفة الأجرة قبل الانطلاق.'
    ]
  },
  {
    icon: '🚆',
    title: 'بقطار الحرمين',
    badge: 'محطة المدينة المنورة',
    steps: [
      'يربط قطار الحرمين السريع المدينة المنورة بكل من مكة المكرمة وجدة، وتقع محطته جنوب شرق وسط المدينة.',
      'من المحطة استقل تطبيق توصيل أو سيارة أجرة إلى «حديقة الملك فهد المركزية»، وتستغرق الرحلة نحو 15–25 دقيقة.',
      'هذا الخيار مناسب لمن يصل من جدة أو مكة ويريد الوصول إلى الحديقة مباشرة دون الدخول إلى قلب المدينة.'
    ]
  },
  {
    icon: '🚕',
    title: 'بسيارة أجرة أو تطبيق توصيل',
    badge: 'الأيسر داخل المدينة',
    steps: [
      'أوبر وكريم وسيارات الأجرة التقليدية متاحة في معظم أحياء المدينة؛ اكتب الوجهة باسمها الكامل أو الرمز CJC4+2F.',
      'من المسجد النبوي الشريف تبعد الحديقة نحو خمسة كيلومترات إلى الجنوب، وتستغرق الرحلة نحو 10–20 دقيقة.',
      'في مواسم الذروة والفعاليات يُفضّل الطلب المبكر لأن الطلب يزيد قرب المساء.'
    ]
  },
  {
    icon: '🚌',
    title: 'بالنقل العام داخل المدينة',
    badge: 'حافلات المدينة',
    steps: [
      'تشغّل المدينة شبكة حافلات للنقل داخل الأحياء؛ حدّد أقرب موقف عبر تطبيق الخرائط أو منصة النقل قبل الرحلة.',
      'لا يعتمد هذا الدليل رقم خط ثابتاً حتى لا يرشد لمسار قد يتغير، فراجع الجدول والمسار المباشر في التطبيق وقت زيارتك.',
      'بعد أقرب موقف للحديقة يتبقّى مشي قصير عبر الأرصفة المظللة حتى المدخل الرئيسي في حي الحديقة.'
    ]
  },
  {
    icon: '🚗',
    title: 'بالسيارة الخاصة',
    badge: 'مواقف رئيسية',
    steps: [
      'وجّه نظام الملاحة إلى «حديقة الملك فهد المركزية» أو الرمز CJC4+2F في حي الحديقة جنوب وسط المدينة.',
      'تذكر أمانة المنطقة وجود ثمانية مواقف رئيسية بمساحة إجمالية تقارب 20,000 م² إضافة إلى مواقف جانبية، ما يسهّل الوقوف قرب المداخل.',
      'في الفعاليات الكبيرة يمتلئ القريب من المواقف مبكراً، لذا يُفضّل الوصول قبل وقت الذروة المسائية.'
    ]
  },
  {
    icon: '🚶',
    title: 'من المسجد النبوي مشياً',
    badge: 'غير موصى به من الوسط',
    steps: [
      'تقع الحديقة على بُعد نحو خمسة كيلومترات جنوب المسجد النبوي، والمشي من الوسط ممكن نظرياً لكنه متعب في حرارة النهار.',
      'الأنسب دمجها مع جولة جنوب المدينة: المسجد القبلي وبستان المستظل وجادة قباء كلها في النطاق القريب.',
      'إن أردت المشي داخل الحديقة نفسها، فالممرات الواسعة مهيأة للمشي والجري وركوب الدراجات في المناطق المخصصة.'
    ]
  }
];

const summary = [
  { mode: 'طائرة → أوبر/أجرة', dist: '~20 كم', time: '25–40 د' },
  { mode: 'قطار الحرمين → توصيل', dist: 'محطة المدينة', time: '15–25 د' },
  { mode: 'من المسجد النبوي', dist: '~5 كم', time: '10–20 د' },
  { mode: 'حافلات المدينة', dist: 'حسب الخط', time: 'حسب المسار' }
];
---
<section id="الوصول" class="bg-palm-900 py-16 text-white lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr]">
      <div>
        <p class="text-sm font-black text-gold-400">الوصول والخريطة</p>
        <h2 class="mt-3 text-4xl font-black sm:text-5xl">كيف تصل إلى الحديقة من كل مكان</h2>
        <div class="mt-7 space-y-5 text-sm leading-8 text-white/78">
          <p><strong class="text-white">بالطائرة:</strong> المطار الدولي شمال المدينة، ومنه توصيل أو أجرة مباشرة إلى الحديقة خلال نحو نصف ساعة.</p>
          <p><strong class="text-white">بالقطار:</strong> محطة قطار الحرمين تربط المدينة بمكة وجدة، ومنها توصيل قصير إلى الحديقة.</p>
          <p><strong class="text-white">داخل المدينة:</strong> التوصيل وأوبر/كريم هما الأسهل، أمّا الحافلات فتحتاج تخطيطاً عبر تطبيق الخرائط.</p>
          <p><strong class="text-white">من المسجد النبوي:</strong> نحو خمسة كيلومترات جنوباً، توصيل سريع أو دمجها مع جولة جنوب المدينة.</p>
        </div>
        <div class="mt-8 overflow-hidden rounded-[2rem] bg-white shadow-2xl ring-1 ring-white/10">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6461.616883614993!2d39.603600277155515!3d24.420040678219355!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x15bdc08c81f9c289%3A0x3c32ee418fc8dbbc!2sKing%20Fahad%20Central%20Park!5e1!3m2!1sar!2ssa!4v1788420936620!5m2!1sar!2ssa&hl=ar&gl=sa"
            width="100%"
            height="360"
            style="border:0"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="خريطة حديقة الملك فهد المركزية في المدينة المنورة"
          ></iframe>
        </div>
      </div>

      <div class="space-y-4">
        {modes.map((m) => (
          <article class="rounded-3xl border border-white/10 bg-white/5 p-5 lg:p-6">
            <div class="flex items-start justify-between gap-3">
              <h3 class="flex items-center gap-2 text-lg font-black"><span aria-hidden="true">{m.icon}</span>{m.title}</h3>
              <span class="shrink-0 rounded-full bg-gold-400 px-3 py-1 text-[11px] font-black text-night-950">{m.badge}</span>
            </div>
            <ol class="mt-4 space-y-2 text-sm leading-7 text-white/78">
              {m.steps.map((s) => (
                <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400" aria-hidden="true"></span><span>{s}</span></li>
              ))}
            </ol>
          </article>
        ))}

        <div class="overflow-hidden rounded-3xl border border-white/10">
          <table class="w-full text-right text-sm">
            <thead class="bg-white/10 text-white">
              <tr><th class="px-4 py-3 font-black">الوسيلة</th><th class="px-4 py-3 font-black">المسافة التقريبية</th><th class="px-4 py-3 font-black">الزمن التقريبي</th></tr>
            </thead>
            <tbody class="divide-y divide-white/10 text-white/80">
              {summary.map((r) => (
                <tr><td class="px-4 py-3 font-black">{r.mode}</td><td class="px-4 py-3" dir="ltr">{r.dist}</td><td class="px-4 py-3" dir="ltr">{r.time}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
