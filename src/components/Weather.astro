---
import {loadWeather} from '../lib/weather';

interface Props {
  lang?: 'ar' | 'en';
}
const { lang = 'ar' } = Astro.props;
const isEn = lang === 'en';

const payload=await loadWeather();
const ok=payload!==null;
const WMO_AR: Record<number, { text: string; icon: string }> = {
  0: { text: 'صحو', icon: '☀️' },
  1: { text: 'صحو غالباً', icon: '🌤️' },
  2: { text: 'غائم جزئياً', icon: '⛅' },
  3: { text: 'غائم', icon: '☁️' },
  45: { text: 'ضباب', icon: '🌫️' },
  48: { text: 'ضباب متجمد', icon: '🌫️' },
  51: { text: 'رذاذ خفيف', icon: '🌦️' },
  53: { text: 'رذاذ متفرق', icon: '🌦️' },
  55: { text: 'رذاذ كثيف', icon: '🌧️' },
  56: { text: 'رذاذ متجمد', icon: '🌧️' },
  57: { text: 'رذاذ متجمد كثيف', icon: '🌧️' },
  61: { text: 'مطر خفيف', icon: '🌧️' },
  63: { text: 'مطر', icon: '🌧️' },
  65: { text: 'مطر غزير', icon: '🌧️' },
  66: { text: 'مطر متجمد', icon: '🌧️' },
  67: { text: 'مطر متجمد غزير', icon: '🌧️' },
  71: { text: 'ثلوج خفيفة', icon: '🌨️' },
  73: { text: 'ثلوج', icon: '❄️' },
  75: { text: 'ثلوج كثيفة', icon: '❄️' },
  77: { text: 'حبيبات ثلجية', icon: '❄️' },
  80: { text: 'زخات مطر', icon: '🌦️' },
  81: { text: 'زخات مطر قوية', icon: '🌧️' },
  82: { text: 'زخات مطر عنيفة', icon: '⛈️' },
  85: { text: 'زخات ثلج', icon: '🌨️' },
  86: { text: 'زخات ثلج كثيفة', icon: '❄️' },
  95: { text: 'عاصفة رعدية', icon: '⛈️' },
  96: { text: 'عاصفة رعدية مع برد', icon: '⛈️' },
  99: { text: 'عاصفة رعدية شديدة مع برد', icon: '⛈️' }
};

const WMO_EN: Record<number, { text: string; icon: string }> = {
  0: { text: 'Clear', icon: '☀️' },
  1: { text: 'Mainly clear', icon: '🌤️' },
  2: { text: 'Partly cloudy', icon: '⛅' },
  3: { text: 'Overcast', icon: '☁️' },
  45: { text: 'Fog', icon: '🌫️' },
  48: { text: 'Depositing rime fog', icon: '🌫️' },
  51: { text: 'Light drizzle', icon: '🌦️' },
  53: { text: 'Moderate drizzle', icon: '🌦️' },
  55: { text: 'Dense drizzle', icon: '🌧️' },
  56: { text: 'Light freezing drizzle', icon: '🌧️' },
  57: { text: 'Dense freezing drizzle', icon: '🌧️' },
  61: { text: 'Slight rain', icon: '🌧️' },
  63: { text: 'Moderate rain', icon: '🌧️' },
  65: { text: 'Heavy rain', icon: '🌧️' },
  66: { text: 'Light freezing rain', icon: '🌧️' },
  67: { text: 'Heavy freezing rain', icon: '🌧️' },
  71: { text: 'Slight snow', icon: '🌨️' },
  73: { text: 'Moderate snow', icon: '❄️' },
  75: { text: 'Heavy snow', icon: '❄️' },
  77: { text: 'Snow grains', icon: '❄️' },
  80: { text: 'Rain showers', icon: '🌦️' },
  81: { text: 'Moderate rain showers', icon: '🌧️' },
  82: { text: 'Violent rain showers', icon: '⛈️' },
  85: { text: 'Snow showers', icon: '🌨️' },
  86: { text: 'Heavy snow showers', icon: '❄️' },
  95: { text: 'Thunderstorm', icon: '⛈️' },
  96: { text: 'Thunderstorm with hail', icon: '⛈️' },
  99: { text: 'Severe thunderstorm with hail', icon: '⛈️' }
};

function wmoInfo(code: number | null | undefined) {
  const table = isEn ? WMO_EN : WMO_AR;
  return code != null && table[code] ? table[code] : { text: isEn ? 'Unspecified condition' : 'حالة غير محددة', icon: '🌡️' };
}

function beaufort(kmh: number) {
  if (kmh < 1) return 0;
  if (kmh <= 5) return 1;
  if (kmh <= 11) return 2;
  if (kmh <= 19) return 3;
  if (kmh <= 28) return 4;
  if (kmh <= 38) return 5;
  if (kmh <= 49) return 6;
  if (kmh <= 61) return 7;
  if (kmh <= 74) return 8;
  if (kmh <= 88) return 9;
  if (kmh <= 102) return 10;
  return 11;
}

function uvLabel(uv: number) {
  if (uv < 3) return isEn ? 'Low' : 'ضعيفة';
  if (uv <= 5) return isEn ? 'Moderate' : 'متوسطة';
  if (uv <= 7) return isEn ? 'High' : 'قوية';
  return isEn ? 'Very high' : 'شديدة';
}

const dayNames = ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
const monthNames = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'];
const dayNamesEn = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const monthNamesEn = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

function arabicLabel(isoDate: string) {
  const [y, m, d] = isoDate.split('-').map(Number);
  const day = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
  return `${dayNames[day]} · ${d} ${monthNames[m - 1]}`;
}

function englishLabel(isoDate: string) {
  const [y, m, d] = isoDate.split('-').map(Number);
  const day = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
  return `${dayNamesEn[day]} · ${d} ${monthNamesEn[m - 1]}`;
}

const current = ok ? payload.current : null;
const daily = ok ? payload.daily : null;
const currentWmo = current ? wmoInfo(current.weather_code) : null;

// تصنيف الحالة ليوم الزيارة (لحظي + يومي) لاشتقاق نصائح عملية.
const RAIN = new Set([51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82, 95, 96, 99]);
const HEAVY = new Set([65, 67, 82]);
const THUNDER = new Set([95, 96, 99]);
const nowCode = current?.weather_code;
const todayCode = daily?.weather_code?.[0];
const isRainNow = nowCode != null && RAIN.has(nowCode);
const isRainToday = todayCode != null && RAIN.has(todayCode);
const isThunder = (nowCode != null && THUNDER.has(nowCode)) || (todayCode != null && THUNDER.has(todayCode));
const heavyRain = (nowCode != null && HEAVY.has(nowCode)) || (todayCode != null && HEAVY.has(todayCode));
const rainProb = daily?.precipitation_probability_max?.[0] ?? null;
const likelyRain = (rainProb != null && rainProb >= 60) || isRainNow || isRainToday;
const tmax = daily?.temperature_2m_max?.[0] ?? 0;
const tmin = daily?.temperature_2m_min?.[0] ?? 0;
const tempDiff = tmax - tmin;
const uvMax = daily?.uv_index_max?.[0] ?? 0;
const windNow = current?.wind_speed_10m ?? 0;
const windMax = daily?.wind_speed_10m_max?.[0] ?? windNow;
const windLvl = beaufort(Math.max(windNow, windMax));
const isSunny = nowCode === 0 || nowCode === 1 || todayCode === 0 || todayCode === 1;
const isCloudy = nowCode === 2 || nowCode === 3 || todayCode === 2 || todayCode === 3;
const isFog = nowCode === 45 || nowCode === 48 || todayCode === 45 || todayCode === 48;

// محرّك النصائح: يُعرض فقط ما ينطبق، وما لا ينطبق يُخفى.
const outfitTips: string[] = [];
const planTips: string[] = [];
const itemsTips: string[] = [];
const riskTips: string[] = [];

if (ok) {
  if (tmax >= 32) outfitTips.push(isEn ? 'Wear light cotton clothing, and do not forget a head covering.' : 'ارتدِ ملابس خفيفة وقطنية، ولا تنسَ غطاء رأس.');
  if (tmin <= 10) outfitTips.push(isEn ? 'Carry a warm coat and a scarf for the cold.' : 'احمل معطفاً دافئاً ووشاحاً للبرودة.');
  if (tempDiff > 8) outfitTips.push(isEn ? 'The temperature difference between day and night is large; carry an extra light layer.' : 'فرق الحرارة بين النهار والليل كبير؛ احمل طبقة إضافية خفيفة.');
  if (heavyRain) outfitTips.push(isEn ? 'Wear a rain-resistant coat, and avoid a long umbrella if the wind picks up.' : 'ارتدي معطفاً مقاوماً للمطر، وتجنّب المظلة الطويلة إن نشطت الرياح.');
  else if (likelyRain) outfitTips.push(isEn ? 'Carry a light rainproof coat.' : 'احمل معطفاً خفيفاً واقياً من المطر.');
  if (windLvl >= 5) outfitTips.push(isEn ? 'The wind is active; avoid hats that fly off and loose clothing.' : 'الرياح نشطة؛ تجنّب القبعات التي تطير والملابس الفضفاضة.');

  if (isSunny) planTips.push(isEn ? 'The forecast symbol is clear; choose your activity based on the heat, the wind and the confirmed opening hours.' : 'الرمز المتوقع صحو؛ اختر النشاط حسب الحرارة والرياح وساعات الدخول المؤكدة.');
  if (isCloudy) planTips.push(isEn ? 'Cloud and diffused light; arrange your walking and photography based on the actual heat, humidity and wind.' : 'سحب وإضاءة منتشرة؛ رتّب المشي والتصوير حسب الحرارة والرطوبة والرياح الفعلية.');
  if (tmax >= 32) planTips.push(isEn ? 'Shorten your walking time under the sun, and prefer visiting after sunset.' : 'اختصر وقت المشي تحت الشمس، وفضّل الزيارة بعد المغرب.');
  if ((rainProb != null && rainProb >= 60)) planTips.push(isEn ? 'High chance of rain; sit near shaded areas or postpone the exposed route.' : 'احتمال مطر مرتفع؛ اجلس قرب المسطحات المظللة أو أجّل المسار المكشوف.');
  if (isRainNow && !heavyRain) planTips.push(isEn ? 'A precipitation symbol; be aware that the paths may become wet and walk carefully.' : 'رمز هطول؛ انتبه لاحتمال ابتلال المسارات وامشِ بحذر.');
  if (heavyRain) planTips.push(isEn ? 'A heavy rain symbol; reconsider exposed activities and check the local warnings. The forecast does not prove that a facility is closed.' : 'رمز أمطار غزيرة؛ أعد النظر في النشاط المكشوف وراجع التحذيرات المحلية. لا يثبت التوقع إغلاق مرفق.');
  if (isThunder) planTips.push(isEn ? 'A thunderstorm; do not sit under trees and do not approach the edge of the lake.' : 'عاصفة رعدية؛ لا تجلس تحت الأشجار ولا تقترب من حافة البحيرة.');
  if (isFog) planTips.push(isEn ? 'Fog reduces visibility; not suitable for distant photography today.' : 'ضباب يضعف الرؤية؛ غير مناسب للتصوير البعيد اليوم.');
  if (windLvl >= 7) planTips.push(isEn ? 'Strong winds; avoid approaching the edges of the lake and the exposed paths.' : 'رياح قوية؛ تجنّب الاقتراب من حواف البحيرة والمسارات المكشوفة.');

  if (heavyRain) itemsTips.push(isEn ? 'A water-resistant umbrella' : 'مطرّة مقاومة للماء');
  else if ((rainProb != null && rainProb >= 60) || isRainNow) itemsTips.push(isEn ? 'A foldable umbrella' : 'مظلّة قابلة للطي');
  if (uvMax >= 3) itemsTips.push(isEn ? 'Sunscreen and sunglasses' : 'واقٍ شمسي ونظارة شمسية');
  if (tmax >= 32) { itemsTips.push(isEn ? 'A hat and light clothing' : 'قبعة وزي خفيف'); itemsTips.push(isEn ? 'Enough drinking water' : 'مياه شرب كافية'); }
  if (tmin <= 10) itemsTips.push(isEn ? 'A warm coat' : 'معطف دافئ');
  if (heavyRain && windLvl >= 5) itemsTips.push(isEn ? 'Avoid the long umbrella (wind)' : 'تجنّب المظلة الطويلة (الرياح)');

  if (isThunder) riskTips.push(isEn ? 'A thunderstorm; adjust your activity and keep away from the lake and the trees.' : 'عاصفة رعدية؛ عدّل نشاطك وابتعد عن البحيرة والأشجار.');
  if (heavyRain) riskTips.push(isEn ? 'Heavy rain; avoid low-lying areas and the water’s edge.' : 'أمطار غزيرة؛ تجنّب المناطق المنخفضة وحواف المياه.');
  if (tmax >= 45) riskTips.push(isEn ? 'A heatwave; reduce sun exposure and watch the children and the elderly.' : 'موجة حرارة؛ قلّل التعرّض للشمس وراقب الأطفال وكبار السن.');
  if (windLvl >= 7) riskTips.push(isEn ? 'Strong winds; keep away from the water’s edge, the signs and the branches.' : 'رياح قوية؛ ابتعد عن حواف المياه واللوحات والفروع.');

  if (outfitTips.length === 0) outfitTips.push(isEn ? 'Choose clothing and shoes suited to your ability, the route and the conditions at the time of your visit.' : 'اختر ملابس وأحذية مناسبة لقدرتك والمسار والظروف عند الزيارة.');
  if (planTips.length === 0) planTips.push(isEn ? 'Check the current forecast and the opening hours before choosing an activity.' : 'راجع النشرة الحالية وساعات الدخول قبل اختيار النشاط.');
  if (itemsTips.length === 0) itemsTips.push(isEn ? 'Prepare what you need for water, the return and contact according to your plan.' : 'جهّز ما تحتاجه للماء والعودة والاتصال بحسب خطتك.');
}
---
<section id={isEn ? 'weather' : 'الطقس'} class="bg-white py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-black text-gold-600">{isEn ? 'Weather conditions near the park' : 'حالة الطقس قرب الحديقة'}</p>
      <h2 class="mt-3 text-4xl font-black text-palm-900 sm:text-5xl">{isEn ? 'Weather snapshot at page build time and seven dates' : 'لقطة الطقس عند إنشاء الصفحة وسبعة تواريخ'}</h2>
      <p class="mt-5 text-lg leading-9 text-palm-900/70">{isEn ? 'Open-Meteo model forecasts are fetched at page build time; this is not a station inside the park and not a live update. Check the reading date and the current forecast; your browser does not request weather data.' : 'تُجلب توقعات نموذج Open-Meteo عند إنشاء الصفحة، وليست محطة داخل الحديقة ولا تحديثاً لحظياً. راجع تاريخ القراءة والنشرة الحالية؛ لا يطلب متصفحك بيانات الطقس.'}</p>
    </div>

    {
      !ok ? (
        <div class="mt-10 rounded-[2rem] border border-palm-900/10 bg-sand-50 p-8 text-sm leading-8 text-palm-900/68">
          {isEn ? 'Weather data could not be fetched at the time this page was built. You can check the current conditions from weather apps or a mapping service before heading to the park.' : 'تعذّر جلب بيانات الطقس وقت إنشاء هذه الصفحة. يمكنك الاطلاع على الحالة الراهنة من تطبيقات الطقس أو خدمة الخرائط قبل التوجه إلى الحديقة.'}
        </div>
      ) : (
        <div class="mt-10 grid gap-6 lg:grid-cols-[.85fr_1.15fr]">
          <article class="min-w-0 rounded-[2rem] bg-palm-900 p-7 text-white lg:p-9">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-black text-gold-400">{isEn ? 'Reading at build time' : 'القراءة وقت إنشاء الصفحة'}</p>
                <p class="mt-2 text-sm text-white/70"><bdi dir="ltr">{current.time} · Asia/Riyadh</bdi></p>
                <p class="mt-5 text-6xl font-black tracking-tight" dir="ltr">{Math.round(current.temperature_2m)}°<span dir={isEn ? undefined : 'rtl'} class="align-top text-3xl text-gold-400">{isEn ? 'C' : 'م'}</span></p>
                <p class="mt-3 flex items-center gap-2 text-xl font-black"><span aria-hidden="true">{currentWmo!.icon}</span>{currentWmo!.text}</p>
              </div>
              <div class="text-7xl leading-none" aria-hidden="true">{currentWmo!.icon}</div>
            </div>
            <dl class="mt-7 grid grid-cols-2 gap-3 border-t border-white/15 pt-6 text-center text-sm">
              <div><dt class="text-white/60">{isEn ? 'Feels like' : 'الإحساس'}</dt><dd class="mt-1 text-lg font-black" dir="ltr">{Math.round(current.apparent_temperature)}°</dd></div>
              <div><dt class="text-white/60">{isEn ? 'Humidity' : 'الرطوبة'}</dt><dd class="mt-1 text-lg font-black" dir="ltr">{Math.round(current.relative_humidity_2m)}{isEn ? '%' : '٪'}</dd></div>
              <div><dt class="text-white/60">{isEn ? 'Wind speed at the snapshot' : 'سرعة الرياح في اللقطة'}</dt><dd class="mt-1 text-lg font-black"><bdi dir="ltr">{Math.round(windNow)} {isEn ? 'km/h' : 'كم/س'}</bdi><span class="mt-1 block text-xs font-bold leading-6 text-white/60">{isEn ? 'Maximum wind strength today (from the current reading and the daily maximum): ' : 'أقصى قوة رياح اليوم (من القراءة الحالية والحد اليومي): '}<bdi dir="ltr">{windLvl} Bft</bdi> — {isEn ? 'Beaufort scale' : 'مقياس بوفورت'}</span></dd></div>
              <div><dt class="text-white/60">{isEn ? 'UV index' : 'الأشعة فوق البنفسجية'}</dt><dd class="mt-1 text-lg font-black" dir="ltr">{uvMax} <span class="text-xs font-bold text-white/60">{uvLabel(uvMax)}</span></dd></div>
            </dl>
            <p class="mt-4 rounded-2xl bg-white/10 px-4 py-3 text-center text-sm font-black">
              {rainProb===null ? (isEn ? 'Rain probability unavailable' : 'احتمال المطر غير متاح') : (isEn ? `Rain probability on the snapshot date ${rainProb}%` : `احتمال المطر في تاريخ اللقطة ${rainProb}٪`)}
            </p>
          </article>

          <div class="min-w-0 grid gap-4 sm:grid-cols-2 lg:grid-cols-2">
            {
              daily.time.map((day: string, index: number) => {
                const info = wmoInfo(daily.weather_code?.[index]);
                const max = Math.round(daily.temperature_2m_max?.[index] ?? 0);
                const min = Math.round(daily.temperature_2m_min?.[index] ?? 0);
                const rain = daily.precipitation_probability_max?.[index];
                return (
                  <article class={'rounded-3xl border p-5 ' + (index === 0 ? 'border-gold-400/50 bg-gold-400/10 ring-1 ring-gold-400/30' : 'border-palm-900/10 bg-sand-50')}>
                    <div class="flex items-center justify-between gap-3">
                      <h3 class="text-sm font-black text-palm-900">{isEn ? englishLabel(day) : arabicLabel(day)}</h3>
                      <span class="text-2xl" aria-hidden="true">{info.icon}</span>
                    </div>
                    <p class="mt-2 text-sm font-bold text-palm-900/70">{info.text}</p>
                    <p class="mt-3 text-2xl font-black" dir="ltr">{max}° <span class="text-base font-bold text-palm-900/50">{min}°</span></p>
                    <p class="mt-1 text-xs text-palm-900/55">{rain == null ? (isEn ? 'No rain estimates available' : 'لا تتوفر تقديرات أمطار') : (rain > 0 ? (isEn ? `Rain chance ${rain}%` : `احتمال أمطار ${rain}٪`) : (isEn ? 'Slight chance of rain' : 'احتمال أمطار ضئيل'))}</p>
                  </article>
                );
              })
            }
          </div>
        </div>
      )
    }

    {
      ok && riskTips.length > 0 && (
        <div class="mt-8 rounded-[2rem] border border-red-200 bg-red-50 p-6">
          <p class="flex items-center gap-2 text-base font-black text-red-700"><span aria-hidden="true">⚠️</span>{isEn ? 'Weather alert' : 'تنبيه جوي'}</p>
          <ul class="mt-3 space-y-2 text-sm leading-7 text-red-700/90">
            {riskTips.map((t) => (
              <li class="flex gap-2"><span aria-hidden="true">•</span><span>{t}</span></li>
            ))}
          </ul>
        </div>
      )
    }

    {
      ok && (
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          <article class="rounded-[2rem] border border-palm-900/10 bg-sand-50 p-6">
            <h3 class="flex items-center gap-2 text-lg font-black text-palm-900"><span aria-hidden="true">🧥</span>{isEn ? 'What to wear' : 'ماذا تلبس'}</h3>
            <ul class="mt-4 space-y-2 text-sm leading-7 text-palm-900/75">
              {outfitTips.map((t) => (
                <li class="flex gap-2"><span class="mt-1 text-gold-600" aria-hidden="true">✓</span><span>{t}</span></li>
              ))}
            </ul>
          </article>
          <article class="rounded-[2rem] border border-palm-900/10 bg-sand-50 p-6">
            <h3 class="flex items-center gap-2 text-lg font-black text-palm-900"><span aria-hidden="true">🗺️</span>{isEn ? 'How to plan your visit' : 'كيف ترتّب زيارتك'}</h3>
            <ul class="mt-4 space-y-2 text-sm leading-7 text-palm-900/75">
              {planTips.map((t) => (
                <li class="flex gap-2"><span class="mt-1 text-gold-600" aria-hidden="true">✓</span><span>{t}</span></li>
              ))}
            </ul>
          </article>
          <article class="rounded-[2rem] border border-palm-900/10 bg-sand-50 p-6">
            <h3 class="flex items-center gap-2 text-lg font-black text-palm-900"><span aria-hidden="true">🎒</span>{isEn ? 'What to bring with you' : 'ماذا تحمل معك'}</h3>
            <ul class="mt-4 space-y-2 text-sm leading-7 text-palm-900/75">
              {itemsTips.map((t) => (
                <li class="flex gap-2"><span class="mt-1 text-gold-600" aria-hidden="true">✓</span><span>{t}</span></li>
              ))}
            </ul>
          </article>
        </div>
      )
    }

    <p class="mt-8 max-w-4xl text-xs leading-6 text-palm-900/50">
      {isEn ? 'This is a static model snapshot from page build time; it may become outdated and may differ from the conditions in the park, and it is not permission for facilities to open. Check the official weather forecast before heading out in the rain or dust seasons.' : 'هذه لقطة نموذجية ثابتة وقت إنشاء الصفحة؛ قد تصبح قديمة وقد تختلف عن ظروف الحديقة، وليست تصريحاً بفتح المرافق. راجع نشرة الطقس الرسمية قبل التحرك في مواسم الأمطار أو الغبار.'}
    </p>
  </div>
</section>
