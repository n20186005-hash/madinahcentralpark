---
// خدمات ومرافق بوصفها أنواعاً فقط (من دون أسماء منشآت)، انسجاماً مع الطابع الإرشادي غير الربحي للمشروع.
const facilities = [
  {
    "icon": "🅿️",
    "title": "مواقف السيارات",
    "note": "وصف مؤرخ",
    "body": "وثقت الأمانة في 9 سبتمبر 2024 ثمانية مواقف رئيسية ومواقف طولية. تحقق من المدخل المفتوح والموقف المناسب؛ لا نضمن توافر مكان."
  },
  {
    "icon": "🚻",
    "title": "دورات المياه والمياه",
    "note": "تحقق قبل الاعتماد",
    "body": "اسأل عن موقع دورة المياه ومياه الشرب وساعاتها ومدى ملاءمتها لاحتياجك. لا يثبت هذا الدليل توفرها عند كل مدخل."
  },
  {
    "icon": "🧒",
    "title": "ألعاب الأطفال",
    "note": "مصادر رسمية",
    "body": "تذكر الأمانة ومنصة المدينة مناطق للأطفال. تحقق من فتح اللعبة والسن المناسب وأشرف على الطفل؛ وصف المنطقة لا يضمن عمل كل جهاز."
  },
  {
    "icon": "🚶",
    "title": "الممشى والرياضة",
    "note": "مصادر رسمية",
    "body": "تصف المصادر مسارات للمشي والجري والدراجات. اتبع المسار المسموح والإرشادات، واختر مسافة تناسب قدرتك والطقس."
  },
  {
    "icon": "🍽️",
    "title": "الطعام والشراب",
    "note": "تحقق من التشغيل",
    "body": "تذكر منصة المدينة مطاعم ضمن المرافق. تحقق من اسم المنشأة المفتوحة وساعاتها وسعرها؛ لا توجد هنا قائمة تجارية موثقة لفروع بعينها."
  },
  {
    "icon": "♿",
    "title": "سهولة الوصول",
    "note": "احتياج فردي",
    "body": "رمز المدخل المهيأ في الخرائط ليس تقييماً لجميع المسارات. تحقق من الموقف والمدخل والسطح ودورة المياه المناسبة قبل الزيارة."
  }
];
---
<section id="المرافق" class="bg-sand-50 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[.65fr_1.35fr] lg:items-end">
      <div>
        <p class="text-sm font-black text-gold-600">الخدمات والمرافق</p>
        <h2 class="mt-3 text-4xl font-black text-palm-900 sm:text-5xl">كل ما يهمك قبل الزيارة</h2>
      </div>
      <p class="text-lg leading-9 text-palm-900/70">نميز بين المرافق التي وصفتها المصادر الرسمية وبين خدمات ينبغي التحقق منها يوم الزيارة. أوصاف التطوير المؤرخة لا تضمن تشغيل كل مرفق الآن.</p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {facilities.map((item) => (
        <article class="flex flex-col rounded-[2rem] border border-palm-900/10 bg-white p-6">
          <div class="flex items-start justify-between gap-3">
            <span class="text-3xl" aria-hidden="true">{item.icon}</span>
            <span class="rounded-full border border-palm-900/10 bg-sand-50 px-3 py-1 text-[11px] font-black text-palm-900/60">{item.note}</span>
          </div>
          <h3 class="mt-4 text-xl font-black text-palm-900">{item.title}</h3>
          <p class="mt-3 text-sm leading-8 text-palm-900/68">{item.body}</p>
        </article>
      ))}
    </div>

    <div class="mt-8 rounded-3xl border border-gold-400/40 bg-gold-400/10 p-5 text-sm leading-8 text-palm-900/75">
      <strong class="font-black">ملاحظة الحياد:</strong> الأوصاف الرسمية المشار إليها تعود إلى منشور الأمانة في 9 سبتمبر 2024 وصفحة منصة المدينة. تحقق من الخدمات الحالية والرسوم عند الجهة المشغلة.
    </div>
  </div>
</section>
