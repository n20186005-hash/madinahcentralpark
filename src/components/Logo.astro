---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<a href="/" class="inline-flex items-center gap-3 no-underline" aria-label="الصفحة الرئيسية لدليل حديقة الملك فهد المركزية">
  <span class="grid h-12 w-12 place-items-center rounded-2xl bg-sand-50 ring-1 ring-palm-900/10">
    <svg viewBox="0 0 64 64" class="h-10 w-10" aria-hidden="true">
      <path d="M31 51V26" stroke="#173324" stroke-width="6" stroke-linecap="round"/>
      <path d="M31 27C19 25 13 18 11 10c10 0 17 4 20 11M32 27c12-2 19-9 22-17-10 0-18 4-22 11M31 30c-9 1-15 5-19 11 8 0 14-2 19-7M32 30c9 1 16 5 20 11-8 0-15-2-20-7" fill="none" stroke="#517b58" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M12 52c13-10 26-12 40-7" fill="none" stroke="#d2aa61" stroke-width="5" stroke-linecap="round"/>
    </svg>
  </span>
  {!compact && <span><strong class="block text-sm font-black text-palm-900 sm:text-base">حديقة الملك فهد المركزية</strong><span class="mt-0.5 block text-[11px] font-bold text-gold-600 sm:text-xs">دليل الزائر · المدينة المنورة</span></span>}
</a>
