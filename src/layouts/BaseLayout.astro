---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: unknown | unknown[];
  noindex?: boolean;
}

const { title, description, image = '/images/park-concept.svg', jsonLd, noindex = false } = Astro.props;
const absolutePageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const absoluteImageUrl = Astro.site ? new URL(image, Astro.site).href : undefined;
const ldItems = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---
<!doctype html>
<html lang="ar-SA" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#173324" />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex,follow" />
    ) : (
      <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    )}
    <title>{title}</title>
    {absolutePageUrl && <link rel="canonical" href={absolutePageUrl} />}
    <link rel="alternate" hreflang="ar-SA" href={absolutePageUrl} />
    <link rel="alternate" hreflang="x-default" href={absolutePageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content="حديقة الملك فهد المركزية" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="حديقة الملك فهد المركزية" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:site_name" content="حديقة الملك فهد المركزية بالمدينة المنورة" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {absolutePageUrl && <meta property="og:url" content={absolutePageUrl} />}
    {absoluteImageUrl && <meta property="og:image" content={absoluteImageUrl} />}
    <meta property="og:image:alt" content="رسم مفاهيمي أصلي؛ ليس صورة للموقع" />
    {absoluteImageUrl && <meta name="twitter:image" content={absoluteImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ldItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)}></script>)}
    <script is:inline src="/analytics.js"></script>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <script is:inline>
      if ('serviceWorker' in navigator && location.protocol === 'https:' && !location.hostname.startsWith('localhost')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
